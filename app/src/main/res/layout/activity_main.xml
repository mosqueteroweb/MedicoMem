<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/idle_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/familyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="@string/family_hint"
        android:textColor="@color/hint"
        android:textSize="13sp" />

    <!-- Al grabar, la pantalla gira 180°: este texto queda en el borde del micrófono, el que mira al médico. -->
    <TextView
        android:id="@+id/doctorHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/doctor_hint_bg"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="@string/doctor_hint"
        android:textColor="@color/red"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/recording"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Medidor de nivel: se mueve al oír voces -->
    <FrameLayout
        android:id="@+id/levelTrack"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/level_track"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <View
            android:id="@+id/levelBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/level_bar" />
    </FrameLayout>

    <TextView
        android:id="@+id/bigButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/start"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="44sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeTextType="uniform" />

    <TextView
        android:id="@+id/footerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:text="@string/not_configured"
        android:textColor="@color/hint"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
