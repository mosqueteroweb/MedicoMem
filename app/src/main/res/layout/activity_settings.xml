<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/SettingsTitle" android:text="@string/settings_title" android:textSize="24sp" />

        <TextView style="@style/SettingsLabel" android:labelFor="@id/nameInput" android:text="@string/name_label" />
        <EditText android:id="@+id/nameInput" style="@style/SettingsInput" android:autofillHints="name"
            android:imeOptions="flagNoPersonalizedLearning" android:inputType="textCapWords" />

        <TextView style="@style/SettingsLabel" android:labelFor="@id/tokenInput" android:text="@string/token_label" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <!-- Oculto con puntos: no aparece en capturas ni en la vista de apps recientes -->
            <EditText android:id="@+id/tokenInput" style="@style/SettingsInput"
                android:layout_width="0dp" android:layout_weight="1" android:importantForAutofill="no"
                android:imeOptions="flagNoPersonalizedLearning"
                android:inputType="textPassword|textNoSuggestions" android:fontFamily="monospace" />
            <Button android:id="@+id/tokenToggle" android:layout_width="56dp" android:layout_height="52dp"
                android:contentDescription="@string/token_show" android:text="👁" android:textSize="20sp"
                style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>

        <TextView style="@style/SettingsLabel" android:labelFor="@id/chatInput" android:text="@string/chat_label" />
        <EditText android:id="@+id/chatInput" style="@style/SettingsInput" android:importantForAutofill="no"
            android:imeOptions="flagNoPersonalizedLearning" android:inputType="numberSigned" />
        <TextView style="@style/SettingsHelp" android:text="@string/find_chat_help" />
        <Button android:id="@+id/findChatButton" style="@style/SettingsButton" android:text="@string/find_chat" />
        <Button android:id="@+id/testButton" style="@style/SettingsButton" android:text="@string/test_send" />
        <TextView android:id="@+id/testResult" style="@style/SettingsHelp" android:textSize="16sp" />

        <TextView style="@style/SettingsTitle" android:text="@string/network_title" />
        <Switch android:id="@+id/mobileDataSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/mobile_data" android:textSize="16sp" />

        <TextView style="@style/SettingsTitle" android:text="@string/mic_title" />
        <Switch android:id="@+id/enhanceSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/enhance_voice" android:textSize="16sp" />
        <TextView style="@style/SettingsHelp" android:text="@string/enhance_help" />
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/micRaw" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/mic_raw" android:textSize="16sp" />
            <RadioButton android:id="@+id/micStd" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/mic_std" android:textSize="16sp" />
            <RadioButton android:id="@+id/micVideo" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/mic_video" android:textSize="16sp" />
        </RadioGroup>
        <TextView style="@style/SettingsHelp" android:text="@string/placement_tips" android:textSize="15sp" />

        <TextView style="@style/SettingsTitle" android:text="@string/battery_title" />
        <TextView android:id="@+id/batteryStatus" style="@style/SettingsHelp" android:textSize="16sp" />
        <Button android:id="@+id/batteryButton" style="@style/SettingsButton" android:text="@string/battery_button" />
        <Button android:id="@+id/appInfoButton" style="@style/SettingsButton" android:text="@string/app_info_button" />

        <TextView style="@style/SettingsTitle" android:text="@string/recordings_title" />
        <LinearLayout android:id="@+id/recordingsList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button android:id="@+id/closeButton" style="@style/SettingsButton"
            android:layout_marginTop="24dp" android:text="@string/close" />
        <TextView android:id="@+id/versionText" style="@style/SettingsHelp" android:gravity="center" />
    </LinearLayout>
</ScrollView>
